{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "build-debug",
			"type": "shell",
			"command": "go",
			"args": [
				"build",
				"-o",
				"dnsmasq-web",
				"."
			],
			"isBackground": false,
			"group": "build"
		},
		{
			"label": "smoke-debug",
			"type": "shell",
			"command": "bash",
			"args": [
				"-lc",
				"./dnsmasq-web --help >/tmp/dnsmasq-web-help.txt && ./dnsmasq-web server -V >/tmp/dnsmasq-web-version.txt && test -s /tmp/dnsmasq-web-help.txt && test -s /tmp/dnsmasq-web-version.txt"
			],
			"isBackground": false,
			"group": "test"
		},
		{
			"label": "build-release",
			"type": "shell",
			"command": "mage",
			"args": [
				"Binaries"
			],
			"isBackground": false,
			"group": "build"
		}
	]
}
